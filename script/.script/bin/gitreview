#!/bin/bash

set -o pipefail

readonly SOURCE_COMMITTED=1
readonly SOURCE_STAGED=2
readonly SOURCE_WORKTREE=4
readonly SOURCE_UNTRACKED=8

mode="list"
base_ref=""
exclude_refs=()
exclude_tips=()
excluded_commits_file=""
excluded_commit_cache_hashes=()
excluded_commit_cache_values=()
include_local=1
include_history=0
porcelain=0
merge_commit_count=0
temp_dir=""
repository_type="generic"
build_system="Unknown"
invocation_dir=""
color_mode="auto"
color_stdout=0
color_stderr=0
git_color_arg="--color=never"

readonly COLOR_RESET=$'\033[0m'
readonly COLOR_BOLD_CYAN=$'\033[1;36m'
readonly COLOR_BOLD_BLUE=$'\033[1;34m'
readonly COLOR_BOLD_MAGENTA=$'\033[1;35m'
readonly COLOR_DIM=$'\033[2m'
readonly COLOR_RED=$'\033[31m'
readonly COLOR_GREEN=$'\033[32m'
readonly COLOR_YELLOW=$'\033[33m'
readonly COLOR_BLUE=$'\033[34m'
readonly COLOR_MAGENTA=$'\033[35m'
readonly COLOR_CYAN=$'\033[36m'

authors=()
pathspecs=()
self_commits=()
build_files=()
spring_layer_order=("Controller" "Service" "Repository" "Client" "Messaging" "Jobs" "Configuration" "Domain" "Tests" "Resources" "Build" "Other")
candidate_modules=()
candidate_layers=()
human_modules=()
human_change_count=0
human_method_count=0

candidate_paths=()
candidate_sources=()
candidate_statuses=()
candidate_commits=()

effective_paths=()
effective_old_paths=()
effective_statuses=()

style_stdout() {
    local style="$1"
    local text="$2"

    if (( color_stdout )); then
        printf '%s%s%s' "$style" "$text" "$COLOR_RESET"
    else
        printf '%s' "$text"
    fi
}

style_stderr() {
    local style="$1"
    local text="$2"

    if (( color_stderr )); then
        printf '%s%s%s' "$style" "$text" "$COLOR_RESET" >&2
    else
        printf '%s' "$text" >&2
    fi
}

configure_colors() {
    color_stdout=0
    color_stderr=0

    if (( ! porcelain )); then
        case "$color_mode" in
            always)
                color_stdout=1
                color_stderr=1
                ;;
            auto)
                if [[ -z "${NO_COLOR:-}" ]]; then
                    [[ -t 1 ]] && color_stdout=1
                    [[ -t 2 ]] && color_stderr=1
                fi
                ;;
        esac
    fi

    if (( color_stdout )); then
        git_color_arg="--color=always"
    else
        git_color_arg="--color=never"
    fi
}

set_color_mode() {
    case "$1" in
        auto|always|never)
            color_mode="$1"
            ;;
        *)
            die "invalid color mode: $1 (expected auto, always, or never)" 2
            ;;
    esac
}

print_status() {
    local status="$1"
    local style="$COLOR_DIM"

    case "$status" in
        A*|\?\?) style="$COLOR_GREEN" ;;
        M*) style="$COLOR_YELLOW" ;;
        D*) style="$COLOR_RED" ;;
        R*|C*) style="$COLOR_CYAN" ;;
    esac

    if (( color_stdout )); then
        printf '%s%-4s%s' "$style" "$status" "$COLOR_RESET"
    else
        printf '%-4s' "$status"
    fi
}

print_source() {
    local source="$1"
    local style="$COLOR_BLUE"

    case "$source" in
        *UNTRACKED*) style="$COLOR_GREEN" ;;
        *STAGED*|*WORKTREE*) style="$COLOR_YELLOW" ;;
        *HISTORY*) style="$COLOR_MAGENTA" ;;
    esac
    style_stdout "$style" "[$source]"
}

print_attribution() {
    local attribution="$1"
    local style="$COLOR_CYAN"

    [[ "$attribution" == "LOCAL" ]] && style="$COLOR_YELLOW"
    style_stdout "$style" "[$attribution]"
}

usage() {
    cat <<'EOF'
Usage: gitreview [options] [-- <pathspec>...]

Review changes authored by the current repository user on the current branch.

Options:
  --patch                 Show patches from matching commits and local changes
  --current-lines         Show surviving changed lines last authored by the user
  --history               Include authored files no longer changed from the base
  --no-local              Exclude staged, unstaged, and untracked changes
  --porcelain             Use the stable tab-separated file list
  --color <when>          Color output: auto, always, or never (default: auto)
  -b, --base <ref>        Override the base ref (default: origin/HEAD)
  --exclude-branch <ref>  Exclude commits reachable from ref; may be repeated
  -a, --author <email>    Match an author email exactly; may be repeated
  -h, --help              Show this help

Environment:
  NO_COLOR                Disable color in auto mode when non-empty

Examples:
  gitreview
  gitreview --patch
  gitreview --exclude-branch develop --exclude-branch release/next
  gitreview --current-lines -- src/
  gitreview --author old@example.com --author new@example.com
EOF
}

die() {
    style_stderr "$COLOR_RED" "gitreview:"
    printf ' %s\n' "$1" >&2
    exit "${2:-1}"
}

cleanup() {
    if [[ -n "$temp_dir" && -d "$temp_dir" ]]; then
        rm -rf -- "$temp_dir"
    fi
}

ensure_temp_dir() {
    [[ -n "$temp_dir" ]] && return 0

    temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/gitreview.XXXXXX") || die "cannot create temporary directory"
    trap cleanup EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
}

set_mode() {
    local requested="$1"

    if [[ "$mode" != "list" && "$mode" != "$requested" ]]; then
        die "--patch and --current-lines cannot be used together" 2
    fi
    mode="$requested"
}

parse_args() {
    while (( $# > 0 )); do
        case "$1" in
            --patch)
                set_mode "patch"
                shift
                ;;
            --current-lines)
                set_mode "current-lines"
                shift
                ;;
            --history)
                include_history=1
                shift
                ;;
            --no-local)
                include_local=0
                shift
                ;;
            --porcelain)
                porcelain=1
                shift
                ;;
            --color)
                (( $# >= 2 )) || die "--color requires auto, always, or never" 2
                set_color_mode "$2"
                shift 2
                ;;
            --color=*)
                set_color_mode "${1#*=}"
                shift
                ;;
            -b|--base)
                (( $# >= 2 )) || die "$1 requires a ref" 2
                base_ref="$2"
                shift 2
                ;;
            --base=*)
                base_ref="${1#*=}"
                [[ -n "$base_ref" ]] || die "--base requires a ref" 2
                shift
                ;;
            --exclude-branch)
                (( $# >= 2 )) || die "--exclude-branch requires a ref" 2
                [[ -n "$2" ]] || die "--exclude-branch requires a ref" 2
                exclude_refs+=("$2")
                shift 2
                ;;
            --exclude-branch=*)
                [[ -n "${1#*=}" ]] || die "--exclude-branch requires a ref" 2
                exclude_refs+=("${1#*=}")
                shift
                ;;
            -a|--author)
                (( $# >= 2 )) || die "$1 requires an email" 2
                authors+=("$2")
                shift 2
                ;;
            --author=*)
                [[ -n "${1#*=}" ]] || die "--author requires an email" 2
                authors+=("${1#*=}")
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            --)
                shift
                while (( $# > 0 )); do
                    pathspecs+=("$1")
                    shift
                done
                ;;
            *)
                die "unknown option: $1" 2
                ;;
        esac
    done
}

selected_author() {
    local email="$1"
    local author

    for author in "${authors[@]}"; do
        [[ "$email" == "$author" ]] && return 0
    done
    return 1
}

prepare_excluded_commits() {
    excluded_commits_file="$temp_dir/excluded-commits"
    : >"$excluded_commits_file" || die "cannot initialize excluded commit list"

    (( ${#exclude_tips[@]} > 0 )) || return 0
    git -C "$repo" rev-list "${exclude_tips[@]}" >"$excluded_commits_file" || \
        die "cannot list commits from excluded branches"
}

commit_is_excluded() {
    local commit="$1"
    local excluded=0
    local i

    [[ -n "$excluded_commits_file" && -s "$excluded_commits_file" ]] || return 1
    for (( i = 0; i < ${#excluded_commit_cache_hashes[@]}; i++ )); do
        if [[ "${excluded_commit_cache_hashes[$i]}" == "$commit" ]]; then
            if (( excluded_commit_cache_values[$i] )); then
                return 0
            fi
            return 1
        fi
    done

    if grep -Fqx -- "$commit" "$excluded_commits_file"; then
        excluded=1
    fi
    excluded_commit_cache_hashes+=("$commit")
    excluded_commit_cache_values+=("$excluded")
    if (( excluded )); then
        return 0
    fi
    return 1
}

candidate_index() {
    local path="$1"
    local i

    for (( i = 0; i < ${#candidate_paths[@]}; i++ )); do
        if [[ "${candidate_paths[$i]}" == "$path" ]]; then
            printf '%d' "$i"
            return 0
        fi
    done
    return 1
}

effective_index() {
    local path="$1"
    local i

    for (( i = 0; i < ${#effective_paths[@]}; i++ )); do
        if [[ "${effective_paths[$i]}" == "$path" ]]; then
            printf '%d' "$i"
            return 0
        fi
    done
    return 1
}

append_commit() {
    local index="$1"
    local commit="$2"
    local short_commit

    [[ -n "$commit" ]] || return 0
    short_commit="${commit:0:8}"

    case ",${candidate_commits[$index]}," in
        *",$short_commit,"*)
            ;;
        *)
            if [[ -n "${candidate_commits[$index]}" ]]; then
                candidate_commits[$index]="${candidate_commits[$index]},$short_commit"
            else
                candidate_commits[$index]="$short_commit"
            fi
            ;;
    esac
}

add_candidate() {
    local path="$1"
    local source="$2"
    local status="$3"
    local commit="${4:-}"
    local index

    if index=$(candidate_index "$path"); then
        candidate_sources[$index]=$(( ${candidate_sources[$index]} | source ))
        [[ -n "$status" ]] && candidate_statuses[$index]="$status"
    else
        index=${#candidate_paths[@]}
        candidate_paths+=("$path")
        candidate_sources+=("$source")
        candidate_statuses+=("$status")
        candidate_commits+=("")
    fi
    append_commit "$index" "$commit"
}

remove_candidate() {
    local index="$1"
    local last=$(( ${#candidate_paths[@]} - 1 ))
    local i

    for (( i = index; i < last; i++ )); do
        candidate_paths[$i]="${candidate_paths[$(( i + 1 ))]}"
        candidate_sources[$i]="${candidate_sources[$(( i + 1 ))]}"
        candidate_statuses[$i]="${candidate_statuses[$(( i + 1 ))]}"
        candidate_commits[$i]="${candidate_commits[$(( i + 1 ))]}"
    done

    unset 'candidate_paths[$last]'
    unset 'candidate_sources[$last]'
    unset 'candidate_statuses[$last]'
    unset 'candidate_commits[$last]'
}

merge_commit_lists() {
    local target="$1"
    local source_list="$2"
    local remaining="$source_list"
    local commit

    while [[ -n "$remaining" ]]; do
        commit="${remaining%%,*}"
        if [[ "$remaining" == *,* ]]; then
            remaining="${remaining#*,}"
        else
            remaining=""
        fi
        append_commit "$target" "$commit"
    done
}

rename_candidate() {
    local old_path="$1"
    local new_path="$2"
    local old_index
    local new_index

    old_index=$(candidate_index "$old_path") || return 0

    if new_index=$(candidate_index "$new_path"); then
        [[ "$old_index" == "$new_index" ]] && return 0
        candidate_sources[$old_index]=$(( ${candidate_sources[$old_index]} | ${candidate_sources[$new_index]} ))
        merge_commit_lists "$old_index" "${candidate_commits[$new_index]}"
        [[ -n "${candidate_statuses[$new_index]}" ]] && candidate_statuses[$old_index]="${candidate_statuses[$new_index]}"
        candidate_paths[$old_index]="$new_path"
        remove_candidate "$new_index"
    else
        candidate_paths[$old_index]="$new_path"
    fi
}

process_commit_diff() {
    local commit="$1"
    local is_self="$2"
    local status
    local path
    local old_path
    local new_path

    last_self_change_count=0

    while IFS= read -r -d '' status; do
        case "$status" in
            R*)
                IFS= read -r -d '' old_path || die "cannot parse rename in $commit"
                IFS= read -r -d '' new_path || die "cannot parse rename in $commit"
                rename_candidate "$old_path" "$new_path"
                if (( is_self )); then
                    add_candidate "$new_path" "$SOURCE_COMMITTED" "$status" "$commit"
                    last_self_change_count=$(( last_self_change_count + 1 ))
                fi
                ;;
            C*)
                IFS= read -r -d '' old_path || die "cannot parse copy in $commit"
                IFS= read -r -d '' new_path || die "cannot parse copy in $commit"
                if (( is_self )); then
                    add_candidate "$new_path" "$SOURCE_COMMITTED" "$status" "$commit"
                    last_self_change_count=$(( last_self_change_count + 1 ))
                fi
                ;;
            *)
                IFS= read -r -d '' path || die "cannot parse path in $commit"
                if (( is_self )); then
                    add_candidate "$path" "$SOURCE_COMMITTED" "$status" "$commit"
                    last_self_change_count=$(( last_self_change_count + 1 ))
                fi
                ;;
        esac
    done
}

collect_committed_changes() {
    local commit
    local author
    local parents
    local is_self
    local commits_file="$temp_dir/commits"
    local diff_file="$temp_dir/commit-diff"
    local exclude_args=()

    if (( ${#exclude_tips[@]} > 0 )); then
        exclude_args=(--not "${exclude_tips[@]}")
    fi
    git -C "$repo" rev-list --reverse --topo-order "$merge_base..HEAD" "${exclude_args[@]}" >"$commits_file" || \
        die "cannot list commits in the review range"
    while IFS= read -r commit; do
        [[ -n "$commit" ]] || continue
        author=$(git -C "$repo" show -s --format='%ae' "$commit") || die "cannot read author for $commit"
        parents=$(git -C "$repo" show -s --format='%P' "$commit") || die "cannot read parents for $commit"
        is_self=0
        selected_author "$author" && is_self=1

        if [[ "$parents" == *' '* ]]; then
            (( is_self )) && merge_commit_count=$(( merge_commit_count + 1 ))
            continue
        fi

        git -C "$repo" diff-tree --root --no-commit-id --name-status -r -M -z "$commit" -- "${pathspecs[@]}" >"$diff_file" || \
            die "cannot inspect files changed by $commit"
        process_commit_diff "$commit" "$is_self" <"$diff_file"

        if (( is_self && last_self_change_count > 0 )); then
            self_commits+=("$commit")
        fi
    done <"$commits_file"
}

process_local_diff() {
    local source="$1"
    local status
    local path
    local old_path
    local new_path

    while IFS= read -r -d '' status; do
        case "$status" in
            R*)
                IFS= read -r -d '' old_path || die "cannot parse local rename"
                IFS= read -r -d '' new_path || die "cannot parse local rename"
                rename_candidate "$old_path" "$new_path"
                add_candidate "$new_path" "$source" "$status"
                ;;
            C*)
                IFS= read -r -d '' old_path || die "cannot parse local copy"
                IFS= read -r -d '' new_path || die "cannot parse local copy"
                add_candidate "$new_path" "$source" "$status"
                ;;
            *)
                IFS= read -r -d '' path || die "cannot parse local path"
                add_candidate "$path" "$source" "$status"
                ;;
        esac
    done
}

collect_local_changes() {
    local path
    local staged_file="$temp_dir/staged"
    local worktree_file="$temp_dir/worktree"
    local untracked_file="$temp_dir/untracked"

    (( include_local )) || return 0

    git -C "$repo" diff --cached --no-ext-diff --name-status -M -z -- "${pathspecs[@]}" >"$staged_file" || \
        die "cannot inspect staged changes"
    process_local_diff "$SOURCE_STAGED" <"$staged_file"

    git -C "$repo" diff --no-ext-diff --name-status -M -z -- "${pathspecs[@]}" >"$worktree_file" || \
        die "cannot inspect worktree changes"
    process_local_diff "$SOURCE_WORKTREE" <"$worktree_file"

    git -C "$repo" ls-files --others --exclude-standard -z -- "${pathspecs[@]}" >"$untracked_file" || \
        die "cannot inspect untracked files"
    while IFS= read -r -d '' path; do
        add_candidate "$path" "$SOURCE_UNTRACKED" "??"
    done <"$untracked_file"
}

add_effective() {
    local path="$1"
    local old_path="$2"
    local status="$3"
    local index

    if index=$(effective_index "$path"); then
        effective_old_paths[$index]="$old_path"
        effective_statuses[$index]="$status"
    else
        effective_paths+=("$path")
        effective_old_paths+=("$old_path")
        effective_statuses+=("$status")
    fi
}

process_effective_diff() {
    local status
    local path
    local old_path
    local new_path

    while IFS= read -r -d '' status; do
        case "$status" in
            R*|C*)
                IFS= read -r -d '' old_path || die "cannot parse effective rename"
                IFS= read -r -d '' new_path || die "cannot parse effective rename"
                add_effective "$new_path" "$old_path" "$status"
                ;;
            *)
                IFS= read -r -d '' path || die "cannot parse effective path"
                add_effective "$path" "" "$status"
                ;;
        esac
    done
}

collect_effective_changes() {
    local path
    local effective_file="$temp_dir/effective"
    local untracked_file="$temp_dir/effective-untracked"

    if (( include_local )); then
        git -C "$repo" diff --no-ext-diff --name-status -M -z "$merge_base" -- "${pathspecs[@]}" >"$effective_file" || \
            die "cannot inspect effective changes"
    else
        git -C "$repo" diff --no-ext-diff --name-status -M -z "$merge_base" HEAD -- "${pathspecs[@]}" >"$effective_file" || \
            die "cannot inspect committed effective changes"
    fi
    process_effective_diff <"$effective_file"

    if (( include_local )); then
        git -C "$repo" ls-files --others --exclude-standard -z -- "${pathspecs[@]}" >"$untracked_file" || \
            die "cannot inspect effective untracked files"
        while IFS= read -r -d '' path; do
            add_effective "$path" "" "??"
        done <"$untracked_file"
    fi
}

add_build_file() {
    local path="$1"
    local existing

    for existing in "${build_files[@]}"; do
        [[ "$existing" == "$path" ]] && return
    done
    build_files+=("$path")
}

detect_repository_type() {
    local build_file
    local build_list="$temp_dir/build-files"
    local has_maven=0
    local has_gradle=0
    local has_spring=0

    build_files=()
    git -C "$repo" ls-files -co --exclude-standard -z -- \
        'pom.xml' ':(glob)**/pom.xml' \
        'build.gradle' ':(glob)**/build.gradle' \
        'build.gradle.kts' ':(glob)**/build.gradle.kts' \
        'settings.gradle' ':(glob)**/settings.gradle' \
        'settings.gradle.kts' ':(glob)**/settings.gradle.kts' >"$build_list" || \
        die "cannot inspect repository build files"

    while IFS= read -r -d '' build_file; do
        [[ -f "$repo/$build_file" ]] || continue
        [[ ! -L "$repo/$build_file" ]] || continue
        add_build_file "$build_file"
        case "$build_file" in
            pom.xml|*/pom.xml)
                has_maven=1
                ;;
            build.gradle|*/build.gradle|build.gradle.kts|*/build.gradle.kts|settings.gradle|*/settings.gradle|settings.gradle.kts|*/settings.gradle.kts)
                has_gradle=1
                ;;
        esac
        if grep -Eiq '(spring[-.]boot|org[.]springframework|springframework[.]boot)' "$repo/$build_file"; then
            has_spring=1
        fi
    done <"$build_list"

    if (( ! has_spring )) && git -C "$repo" grep -I -q -E \
        'org[.]springframework|@SpringBootApplication' -- '*.java' 2>/dev/null; then
        has_spring=1
    fi

    if (( has_maven && has_gradle )); then
        build_system="Maven + Gradle"
    elif (( has_maven )); then
        build_system="Maven"
    elif (( has_gradle )); then
        build_system="Gradle"
    fi

    if (( has_spring )); then
        repository_type="java-spring"
    else
        repository_type="generic"
    fi
}

module_for_path() {
    local path="$1"
    local dir
    local build_file
    local build_dir

    module_name="${repo##*/}"
    if [[ "$path" == */* ]]; then
        dir="${path%/*}"
    else
        dir=""
    fi

    while :; do
        for build_file in "${build_files[@]}"; do
            if [[ "$build_file" == */* ]]; then
                build_dir="${build_file%/*}"
            else
                build_dir=""
            fi
            if [[ "$build_dir" == "$dir" ]]; then
                [[ -n "$dir" ]] && module_name="$dir"
                return
            fi
        done

        [[ -n "$dir" ]] || break
        if [[ "$dir" == */* ]]; then
            dir="${dir%/*}"
        else
            dir=""
        fi
    done
}

classify_spring_layer() {
    local path="$1"
    local lower_path
    local source_file="$repo/$path"

    lower_path=$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')
    spring_layer="Other"

    case "$lower_path" in
        */src/test/*|src/test/*|*/src/integrationtest/*|src/integrationtest/*|*test.java|*tests.java|*it.java)
            spring_layer="Tests"
            return
            ;;
        */src/main/resources/*|src/main/resources/*|*/resources/*|resources/*)
            spring_layer="Resources"
            return
            ;;
        pom.xml|*/pom.xml|build.gradle|*/build.gradle|build.gradle.kts|*/build.gradle.kts|settings.gradle|*/settings.gradle|settings.gradle.kts|*/settings.gradle.kts)
            spring_layer="Build"
            return
            ;;
        */config/*|*/configuration/*|*config.java|*configuration.java)
            spring_layer="Configuration"
            return
            ;;
        */controller/*|*controller.java)
            spring_layer="Controller"
            return
            ;;
        */service/*|*service.java|*serviceimpl.java)
            spring_layer="Service"
            return
            ;;
        */repository/*|*/dao/*|*/mapper/*|*repository.java|*dao.java|*mapper.java)
            spring_layer="Repository"
            return
            ;;
        */client/*|*/remote/*|*/feign/*|*client.java)
            spring_layer="Client"
            return
            ;;
        */listener/*|*/consumer/*|*/messaging/*|*/message/*|*/mq/*)
            spring_layer="Messaging"
            return
            ;;
        */job/*|*/scheduler/*|*/scheduled/*|*/task/*)
            spring_layer="Jobs"
            return
            ;;
        */domain/*|*/entity/*|*/model/*|*/dto/*|*/vo/*|*/request/*|*/response/*)
            spring_layer="Domain"
            return
            ;;
    esac

    if [[ "$lower_path" == *.java && -f "$source_file" && ! -L "$source_file" ]]; then
        if grep -Eq '@(RestController|Controller)' "$source_file"; then
            spring_layer="Controller"
        elif grep -Eq '@Service' "$source_file"; then
            spring_layer="Service"
        elif grep -Eq '@Repository' "$source_file"; then
            spring_layer="Repository"
        elif grep -Eq '@(FeignClient|HttpExchange)' "$source_file"; then
            spring_layer="Client"
        elif grep -Eq '@(KafkaListener|RabbitListener|JmsListener)' "$source_file"; then
            spring_layer="Messaging"
        elif grep -Eq '@(Scheduled|EnableScheduling)' "$source_file"; then
            spring_layer="Jobs"
        elif grep -Eq '@Configuration' "$source_file"; then
            spring_layer="Configuration"
        fi
    fi
}

source_label() {
    local mask="$1"
    local label=""

    if (( mask & SOURCE_COMMITTED )); then
        label="COMMITTED"
    fi
    if (( mask & SOURCE_STAGED )); then
        [[ -n "$label" ]] && label="$label+"
        label="${label}STAGED"
    fi
    if (( mask & SOURCE_WORKTREE )); then
        [[ -n "$label" ]] && label="$label+"
        label="${label}WORKTREE"
    fi
    if (( mask & SOURCE_UNTRACKED )); then
        [[ -n "$label" ]] && label="$label+"
        label="${label}UNTRACKED"
    fi
    printf '%s' "$label"
}

quote_path() {
    printf '%q' "$1"
}

human_path() {
    local path="$1"

    if [[ "$invocation_dir" == "$repo" ]]; then
        printf '%s' "$path"
    else
        printf '%s/%s' "$repo" "$path"
    fi
}

human_location() {
    local path="$1"
    local line="$2"

    printf '%s:%s' "$(human_path "$path")" "$line"
}

sorted_candidate_indices() {
    local indices=()
    local i
    local j
    local previous

    for (( i = 0; i < ${#candidate_paths[@]}; i++ )); do
        if (( ! include_history )) && ! effective_index "${candidate_paths[$i]}" >/dev/null; then
            continue
        fi

        j=${#indices[@]}
        while (( j > 0 )); do
            previous="${indices[$(( j - 1 ))]}"
            [[ "${candidate_paths[$previous]}" > "${candidate_paths[$i]}" ]] || break
            indices[$j]="$previous"
            j=$(( j - 1 ))
        done
        indices[$j]="$i"
    done

    printf '%s\n' "${indices[@]}"
}

print_context() {
    local author_list=""
    local exclude_list=""
    local author
    local exclude_ref
    local short_base

    for author in "${authors[@]}"; do
        [[ -n "$author_list" ]] && author_list="$author_list,"
        author_list="$author_list$author"
    done
    for exclude_ref in "${exclude_refs[@]}"; do
        [[ -n "$exclude_list" ]] && exclude_list="$exclude_list,"
        exclude_list="$exclude_list$exclude_ref"
    done
    short_base=$(git -C "$repo" rev-parse --short=8 "$merge_base") || short_base="$merge_base"

    style_stderr "$COLOR_CYAN" "Repository:"
    printf ' %s\n' "$repo" >&2
    style_stderr "$COLOR_CYAN" "Branch:"
    printf ' %s\n' "$branch" >&2
    style_stderr "$COLOR_CYAN" "Base:"
    printf ' %s (%s)\n' "$base_ref" "$short_base" >&2
    style_stderr "$COLOR_CYAN" "Author:"
    printf ' %s\n' "$author_list" >&2
    if [[ -n "$exclude_list" ]]; then
        style_stderr "$COLOR_CYAN" "Excluded:"
        printf ' %s\n' "$exclude_list" >&2
    fi
    if (( merge_commit_count > 0 )); then
        style_stderr "$COLOR_YELLOW" "Notice:"
        printf ' skipped %d matching merge commit(s)\n' "$merge_commit_count" >&2
    fi
}

render_list() {
    local index
    local effective
    local status
    local source
    local display_path
    local old_path
    local count=0

    while IFS= read -r index; do
        [[ -n "$index" ]] || continue
        source=$(source_label "${candidate_sources[$index]}")

        if effective=$(effective_index "${candidate_paths[$index]}"); then
            status="${effective_statuses[$effective]}"
            old_path="${effective_old_paths[$effective]}"
            if [[ -n "$old_path" ]]; then
                display_path="$(quote_path "$old_path") -> $(quote_path "${effective_paths[$effective]}")"
            else
                display_path=$(quote_path "${effective_paths[$effective]}")
            fi
        else
            status="${candidate_statuses[$index]}"
            source="${source}+HISTORY"
            display_path=$(quote_path "${candidate_paths[$index]}")
        fi

        if [[ -n "${candidate_commits[$index]}" ]]; then
            printf '%s\t%s\t%s\t%s\n' "$status" "$source" "$display_path" "${candidate_commits[$index]}"
        else
            printf '%s\t%s\t%s\n' "$status" "$source" "$display_path"
        fi
        count=$(( count + 1 ))
    done < <(sorted_candidate_indices)

    if (( count == 0 )); then
        printf 'No matching changes found.\n' >&2
    fi
}

resolve_candidate() {
    local index="$1"
    local old_path

    resolved_path="${candidate_paths[$index]}"
    resolved_source=$(source_label "${candidate_sources[$index]}")
    if resolved_effective=$(effective_index "$resolved_path"); then
        resolved_status="${effective_statuses[$resolved_effective]}"
        old_path="${effective_old_paths[$resolved_effective]}"
        if [[ "$resolved_status" == D* ]]; then
            resolved_display_path=$(quote_path "$resolved_path")
        elif [[ -n "$old_path" ]]; then
            resolved_display_path="$(quote_path "$old_path") -> $(human_location "$resolved_path" 1)"
        else
            resolved_display_path=$(human_location "$resolved_path" 1)
        fi
    else
        resolved_effective=""
        resolved_status="${candidate_statuses[$index]}"
        resolved_source="${resolved_source}+HISTORY"
        resolved_display_path=$(quote_path "$resolved_path")
    fi
}

human_type_label() {
    if [[ "$repository_type" == "java-spring" ]]; then
        printf 'Java Spring (%s)' "$build_system"
    else
        printf 'Generic'
    fi
}

render_human_field() {
    local style="$1"
    local label="$2"
    local value="$3"

    printf '  '
    if (( color_stdout )); then
        printf '%s%-11s%s' "$style" "$label" "$COLOR_RESET"
    else
        printf '%-11s' "$label"
    fi
    printf ': %s\n' "$value"
}

render_human_header() {
    local author_list=""
    local exclude_list=""
    local author
    local exclude_ref
    local short_base

    for author in "${authors[@]}"; do
        [[ -n "$author_list" ]] && author_list="$author_list,"
        author_list="$author_list$author"
    done
    for exclude_ref in "${exclude_refs[@]}"; do
        [[ -n "$exclude_list" ]] && exclude_list="$exclude_list,"
        exclude_list="$exclude_list$exclude_ref"
    done
    short_base=$(git -C "$repo" rev-parse --short=8 "$merge_base") || short_base="$merge_base"

    style_stdout "$COLOR_BOLD_CYAN" "Git Review"
    printf '\n'
    render_human_field "$COLOR_CYAN" "Repository" "$repo"
    render_human_field "$COLOR_CYAN" "Type" "$(human_type_label)"
    render_human_field "$COLOR_CYAN" "Branch" "$branch"
    render_human_field "$COLOR_CYAN" "Base" "$base_ref ($short_base)"
    render_human_field "$COLOR_CYAN" "Author" "$author_list"
    if [[ -n "$exclude_list" ]]; then
        render_human_field "$COLOR_CYAN" "Excluded" "$exclude_list"
    fi
    if (( merge_commit_count > 0 )); then
        render_human_field "$COLOR_YELLOW" "Notice" "skipped $merge_commit_count matching merge commit(s)"
    fi
}

render_generic_human() {
    local index

    human_change_count=0
    render_human_header
    printf '\n'
    style_stdout "$COLOR_BOLD_MAGENTA" "Changes"
    printf '\n'
    while IFS= read -r index; do
        [[ -n "$index" ]] || continue
        resolve_candidate "$index"
        printf '  '
        print_status "$resolved_status"
        printf ' '
        print_source "$resolved_source"
        printf ' %s' "$resolved_display_path"
        if [[ -n "${candidate_commits[$index]}" ]]; then
            printf ' '
            style_stdout "$COLOR_DIM" "(${candidate_commits[$index]})"
        fi
        printf '\n'
        human_change_count=$(( human_change_count + 1 ))
    done < <(sorted_candidate_indices)

    if (( human_change_count == 0 )); then
        printf '  '
        style_stdout "$COLOR_YELLOW" "No matching changes found."
        printf '\n'
    fi
    printf '\n'
    style_stdout "$COLOR_BOLD_CYAN" "Summary:"
    printf ' %d file(s)\n' "$human_change_count"
}

add_human_module() {
    local value="$1"
    local existing
    local i
    local j
    local previous

    for existing in "${human_modules[@]}"; do
        [[ "$existing" == "$value" ]] && return
    done

    i=${#human_modules[@]}
    while (( i > 0 )); do
        j=$(( i - 1 ))
        previous="${human_modules[$j]}"
        [[ "$previous" > "$value" ]] || break
        human_modules[$i]="$previous"
        i=$j
    done
    human_modules[$i]="$value"
}

prepare_spring_metadata() {
    local index

    candidate_modules=()
    candidate_layers=()
    human_modules=()
    while IFS= read -r index; do
        [[ -n "$index" ]] || continue
        module_for_path "${candidate_paths[$index]}"
        classify_spring_layer "${candidate_paths[$index]}"
        candidate_modules[$index]="$module_name"
        candidate_layers[$index]="$spring_layer"
        add_human_module "$module_name"
    done < <(sorted_candidate_indices)
}

render_spring_human() {
    local module
    local layer
    local index
    local layer_started

    human_change_count=0
    human_method_count=0
    prepare_spring_metadata
    render_human_header

    for module in "${human_modules[@]}"; do
        printf '\n'
        style_stdout "$COLOR_BOLD_BLUE" "Module:"
        printf ' %s\n' "$module"
        for layer in "${spring_layer_order[@]}"; do
            layer_started=0
            while IFS= read -r index; do
                [[ -n "$index" ]] || continue
                [[ "${candidate_modules[$index]}" == "$module" ]] || continue
                [[ "${candidate_layers[$index]}" == "$layer" ]] || continue
                if (( ! layer_started )); then
                    printf '  '
                    style_stdout "$COLOR_BOLD_MAGENTA" "$layer"
                    printf '\n'
                    layer_started=1
                fi

                resolve_candidate "$index"
                printf '    '
                print_status "$resolved_status"
                printf ' '
                print_source "$resolved_source"
                printf ' %s' "$resolved_display_path"
                if [[ -n "${candidate_commits[$index]}" ]]; then
                    printf ' '
                    style_stdout "$COLOR_DIM" "(${candidate_commits[$index]})"
                fi
                printf '\n'
                if [[ "$resolved_path" == *.java ]]; then
                    render_java_change_details "$index" "$resolved_path"
                fi
                human_change_count=$(( human_change_count + 1 ))
            done < <(sorted_candidate_indices)
        done
    done

    if (( human_change_count == 0 )); then
        printf '\n'
        style_stdout "$COLOR_YELLOW" "No matching changes found."
        printf '\n'
    fi
    printf '\n'
    style_stdout "$COLOR_BOLD_CYAN" "Summary:"
    printf ' %d file(s), %d changed method(s)\n' "$human_change_count" "$human_method_count"
}

render_human() {
    if [[ "$repository_type" == "java-spring" ]]; then
        render_spring_human
    else
        render_generic_human
    fi
}

show_git_diff() {
    local kind="$1"
    local result

    case "$kind" in
        staged)
            if git -C "$repo" diff --cached --no-ext-diff --quiet -- "${pathspecs[@]}"; then
                return 0
            else
                result=$?
            fi
            (( result == 1 )) || die "cannot inspect staged changes"
            printf '\n'
            style_stdout "$COLOR_BOLD_MAGENTA" "=== STAGED ==="
            printf '\n'
            git --no-pager -C "$repo" diff "$git_color_arg" --cached --find-renames -- "${pathspecs[@]}" || die "cannot show staged changes"
            ;;
        worktree)
            if git -C "$repo" diff --no-ext-diff --quiet -- "${pathspecs[@]}"; then
                return 0
            else
                result=$?
            fi
            (( result == 1 )) || die "cannot inspect worktree changes"
            printf '\n'
            style_stdout "$COLOR_BOLD_MAGENTA" "=== WORKTREE ==="
            printf '\n'
            git --no-pager -C "$repo" diff "$git_color_arg" --find-renames -- "${pathspecs[@]}" || die "cannot show worktree changes"
            ;;
    esac
}

render_untracked_patches() {
    local i
    local result

    for (( i = 0; i < ${#candidate_paths[@]}; i++ )); do
        (( ${candidate_sources[$i]} & SOURCE_UNTRACKED )) || continue
        printf '\n'
        style_stdout "$COLOR_BOLD_MAGENTA" "=== UNTRACKED: $(quote_path "${candidate_paths[$i]}") ==="
        printf '\n'
        if git --no-pager -C "$repo" diff "$git_color_arg" --no-index -- /dev/null "${candidate_paths[$i]}"; then
            result=0
        else
            result=$?
        fi
        (( result <= 1 )) || die "cannot show untracked file: ${candidate_paths[$i]}"
    done
}

render_patch() {
    if (( ${#self_commits[@]} > 0 )); then
        git --no-pager -C "$repo" show "$git_color_arg" --find-renames --format=fuller "${self_commits[@]}" -- "${pathspecs[@]}" || die "cannot show authored patches"
    fi

    if (( include_local )); then
        show_git_diff staged
        show_git_diff worktree
        render_untracked_patches
    fi

    if (( ${#self_commits[@]} == 0 && ${#candidate_paths[@]} == 0 )); then
        printf 'No matching changes found.\n' >&2
    fi
}

range_starts=()
range_counts=()
local_range_starts=()
local_range_counts=()

collect_ranges() {
    local revision="$1"
    local path="$2"
    local destination="$3"
    local target="${4:-}"
    local line
    local start
    local count
    local command=(git --literal-pathspecs -C "$repo" diff --no-ext-diff --find-renames --unified=0 "$revision")
    local diff_file="$temp_dir/ranges"

    [[ -n "$target" ]] && command+=("$target")
    command+=(-- "$path")
    "${command[@]}" >"$diff_file" || die "cannot inspect changed lines for $path"

    [[ "$destination" == "final" ]] && { range_starts=(); range_counts=(); }
    [[ "$destination" == "local" ]] && { local_range_starts=(); local_range_counts=(); }

    while IFS= read -r line; do
        if [[ "$line" =~ ^@@[[:space:]]+-[0-9]+(,[0-9]+)?[[:space:]]+\+([0-9]+)(,([0-9]+))?[[:space:]]+@@ ]]; then
            start="${BASH_REMATCH[2]}"
            count="${BASH_REMATCH[4]}"
            [[ -n "$count" ]] || count=1
            (( count > 0 )) || continue
            if [[ "$destination" == "final" ]]; then
                range_starts+=("$start")
                range_counts+=("$count")
            else
                local_range_starts+=("$start")
                local_range_counts+=("$count")
            fi
        fi
    done <"$diff_file"
}

line_is_local() {
    local line_number="$1"
    local i
    local start
    local end

    for (( i = 0; i < ${#local_range_starts[@]}; i++ )); do
        start="${local_range_starts[$i]}"
        end=$(( start + ${local_range_counts[$i]} - 1 ))
        if (( line_number >= start && line_number <= end )); then
            return 0
        fi
    done
    return 1
}

run_start=0
run_end=0
run_key=""
run_hash=""
run_email=""
run_path=""
line_output_count=0
line_sink="stdout"
line_run_file=""

flush_line_run() {
    local location

    (( run_start > 0 )) || return 0
    if [[ "$line_sink" == "file" ]]; then
        if [[ "$run_key" == "LOCAL" ]]; then
            printf '%s\t%s\tLOCAL\n' "$run_start" "$run_end" >>"$line_run_file"
        else
            printf '%s\t%s\t%s\n' "$run_start" "$run_end" "$run_hash" >>"$line_run_file"
        fi
        run_start=0
        run_end=0
        run_key=""
        run_hash=""
        run_email=""
        return 0
    fi

    location="$(human_location "$run_path" "$run_start")"
    if (( run_start != run_end )); then
        location="$location [L$run_start-$run_end]"
    fi

    if [[ "$run_key" == "LOCAL" ]]; then
        printf '%s' "$location"
        printf '\t'
        style_stdout "$COLOR_YELLOW" "LOCAL"
        printf '\n'
    else
        printf '%s' "$location"
        printf '\t'
        style_stdout "$COLOR_CYAN" "$run_hash"
        printf '\t'
        style_stdout "$COLOR_DIM" "$run_email"
        printf '\n'
    fi
    line_output_count=$(( line_output_count + 1 ))
    run_start=0
    run_end=0
    run_key=""
    run_hash=""
    run_email=""
}

append_line_run() {
    local path="$1"
    local line_number="$2"
    local key="$3"
    local hash="$4"
    local email="$5"

    if (( run_start > 0 )) && [[ "$run_path" == "$path" && "$run_key" == "$key" ]] && (( line_number == run_end + 1 )); then
        run_end="$line_number"
        return 0
    fi

    flush_line_run
    run_path="$path"
    run_start="$line_number"
    run_end="$line_number"
    run_key="$key"
    run_hash="$hash"
    run_email="$email"
}

render_blame_range() {
    local path="$1"
    local start="$2"
    local count="$3"
    local end=$(( start + count - 1 ))
    local blame_file="$temp_dir/blame"
    local line
    local hash=""
    local final_line=0
    local email=""
    local short_hash

    if (( include_local )); then
        if ! git --literal-pathspecs -C "$repo" blame --line-porcelain -L "$start,$end" -- "$path" >"$blame_file" 2>/dev/null; then
            return 0
        fi
    else
        if ! git --literal-pathspecs -C "$repo" blame --line-porcelain -L "$start,$end" HEAD -- "$path" >"$blame_file" 2>/dev/null; then
            return 0
        fi
    fi

    while IFS= read -r line; do
        if [[ "$line" =~ ^([0-9a-f]+)[[:space:]]+[0-9]+[[:space:]]+([0-9]+) ]]; then
            hash="${BASH_REMATCH[1]}"
            final_line="${BASH_REMATCH[2]}"
            email=""
        elif [[ "$line" == author-mail\ * ]]; then
            email="${line#author-mail }"
            email="${email#<}"
            email="${email%>}"
        elif [[ "${line:0:1}" == $'\t' ]]; then
            if line_is_local "$final_line"; then
                append_line_run "$path" "$final_line" "LOCAL" "" ""
            elif ! commit_is_excluded "$hash" && selected_author "$email"; then
                short_hash="${hash:0:8}"
                append_line_run "$path" "$final_line" "$hash|$email" "$short_hash" "$email"
            else
                flush_line_run
            fi
        fi
    done <"$blame_file"
    flush_line_run
}

render_untracked_lines() {
    local path="$1"
    local line_count
    local location

    if [[ ! -f "$repo/$path" || -L "$repo/$path" ]]; then
        return 0
    fi

    line_count=$(awk 'END { print NR }' "$repo/$path" 2>/dev/null) || return 0
    if [[ "$line_sink" == "file" ]]; then
        if (( line_count == 0 )); then
            printf '0\t0\tLOCAL\n' >>"$line_run_file"
        else
            printf '1\t%s\tLOCAL\n' "$line_count" >>"$line_run_file"
        fi
        return 0
    fi

    if (( line_count == 0 )); then
        printf '%s' "$(human_path "$path")"
        printf '\t'
        style_stdout "$COLOR_YELLOW" "LOCAL (empty file)"
        printf '\n'
    elif (( line_count == 1 )); then
        human_location "$path" 1
        printf '\t'
        style_stdout "$COLOR_YELLOW" "LOCAL"
        printf '\n'
    else
        location="$(human_location "$path" 1) [L1-$line_count]"
        printf '%s' "$location"
        printf '\t'
        style_stdout "$COLOR_YELLOW" "LOCAL"
        printf '\n'
    fi
    line_output_count=$(( line_output_count + 1 ))
}

collect_owned_runs() {
    local index="$1"
    local path="$2"
    local effective
    local status
    local i

    owned_runs_file="$temp_dir/owned-runs"
    : >"$owned_runs_file"
    line_sink="file"
    line_run_file="$owned_runs_file"
    run_start=0
    run_end=0
    run_key=""
    run_hash=""
    run_email=""
    run_path=""

    if (( ${candidate_sources[$index]} & SOURCE_UNTRACKED )); then
        render_untracked_lines "$path"
        line_sink="stdout"
        line_run_file=""
        return 0
    fi

    if ! effective=$(effective_index "$path"); then
        line_sink="stdout"
        line_run_file=""
        return 0
    fi
    status="${effective_statuses[$effective]}"
    if [[ "$status" == D* ]]; then
        line_sink="stdout"
        line_run_file=""
        return 0
    fi

    if (( include_local )); then
        if [[ ! -f "$repo/$path" ]]; then
            line_sink="stdout"
            line_run_file=""
            return 0
        fi
        collect_ranges "$merge_base" "$path" "final"
        collect_ranges "HEAD" "$path" "local"
    else
        if ! git -C "$repo" cat-file -e "HEAD:$path" 2>/dev/null; then
            line_sink="stdout"
            line_run_file=""
            return 0
        fi
        collect_ranges "$merge_base" "$path" "final" "HEAD"
        local_range_starts=()
        local_range_counts=()
    fi

    for (( i = 0; i < ${#range_starts[@]}; i++ )); do
        render_blame_range "$path" "${range_starts[$i]}" "${range_counts[$i]}"
    done
    flush_line_run
    line_sink="stdout"
    line_run_file=""
}

extract_java_methods() {
    local path="$1"
    local source_file="$repo/$path"

    java_methods_file="$temp_dir/java-methods"
    : >"$java_methods_file"
    if (( ! include_local )); then
        source_file="$temp_dir/java-source"
        git -C "$repo" show "HEAD:$path" >"$source_file" 2>/dev/null || return 0
    elif [[ ! -f "$source_file" || -L "$source_file" ]]; then
        return 0
    fi

    awk '
        function trim(value) {
            sub(/^[[:space:]]+/, "", value)
            sub(/[[:space:]]+$/, "", value)
            return value
        }
        function method_name(signature, position, before, count, parts, i) {
            position = index(signature, "(")
            if (position == 0) {
                return ""
            }
            before = substr(signature, 1, position - 1)
            gsub(/<[^<>]*>/, " ", before)
            count = split(before, parts, /[^[:alnum:]_$]+/)
            for (i = count; i > 0; i--) {
                if (parts[i] ~ /^[[:alpha:]_$][[:alnum:]_$]*$/) {
                    return parts[i]
                }
            }
            return ""
        }
        function excluded(signature, name) {
            if (name == "" || name ~ /^(if|for|while|switch|catch|synchronized|new|return|throw|super|this)$/) {
                return 1
            }
            if (signature ~ /(^|[[:space:]])(class|interface|enum|record)[[:space:]]/) {
                return 1
            }
            if (signature ~ /->/ || signature ~ /=/) {
                return 1
            }
            return 0
        }
        function sanitize(text, result, i, character, following) {
            result = ""
            for (i = 1; i <= length(text); i++) {
                character = substr(text, i, 1)
                following = substr(text, i + 1, 1)

                if (in_block_comment) {
                    if (character == "*" && following == "/") {
                        in_block_comment = 0
                        i++
                    }
                    continue
                }
                if (in_text_block) {
                    if (substr(text, i, 3) == triple_quote) {
                        in_text_block = 0
                        i += 2
                    }
                    continue
                }
                if (quote_character != "") {
                    if (escaped) {
                        escaped = 0
                    } else if (character == backslash) {
                        escaped = 1
                    } else if (character == quote_character) {
                        quote_character = ""
                    }
                    result = result " "
                    continue
                }
                if (character == "/" && following == "*") {
                    in_block_comment = 1
                    i++
                    continue
                }
                if (character == "/" && following == "/") {
                    break
                }
                if (substr(text, i, 3) == triple_quote) {
                    in_text_block = 1
                    i += 2
                    continue
                }
                if (character == double_quote || character == single_quote) {
                    quote_character = character
                    escaped = 0
                    result = result " "
                    continue
                }
                result = result character
            }
            return result
        }
        BEGIN {
            single_quote = sprintf("%c", 39)
            double_quote = sprintf("%c", 34)
            triple_quote = sprintf("%c%c%c", 34, 34, 34)
            backslash = sprintf("%c", 92)
        }
        {
            code = sanitize($0)
            trimmed = trim(code)
            depth_before = depth
            braces = code
            opens = gsub(/\{/, "{", braces)
            braces = code
            closes = gsub(/\}/, "}", braces)

            if (!active) {
                if (pending) {
                    signature = signature " " trimmed
                } else if (index(trimmed, "(") > 0 && trimmed !~ /^@/) {
                    pending = 1
                    signature = trimmed
                    declaration_start = annotation_start ? annotation_start : (prefix_start ? prefix_start : NR)
                }

                if (pending && (index(signature, "{") > 0 || signature ~ /;[[:space:]]*$/)) {
                    name = method_name(signature)
                    if (!excluded(signature, name)) {
                        if (index(signature, "{") > 0) {
                            active = 1
                            active_name = name
                            active_start = declaration_start
                            active_base = depth_before
                        } else {
                            print declaration_start "\t" NR "\t" name
                        }
                    }
                    pending = 0
                    signature = ""
                    annotation_start = 0
                    prefix_start = 0
                } else if (!pending) {
                    if (trimmed ~ /^@/) {
                        if (!annotation_start) {
                            annotation_start = NR
                        }
                    } else if (trimmed ~ /^(public|protected|private|static|final|abstract|default|synchronized|native|strictfp)[[:space:]]/ && trimmed !~ /[;={}]/) {
                        if (!prefix_start) {
                            prefix_start = NR
                        }
                    } else if (trimmed != "") {
                        annotation_start = 0
                        prefix_start = 0
                    }
                }
            }

            depth += opens - closes
            if (active && depth <= active_base) {
                print active_start "\t" NR "\t" active_name
                active = 0
                active_name = ""
                active_start = 0
                annotation_start = 0
                prefix_start = 0
            }
        }
        END {
            if (active) {
                print active_start "\t" NR "\t" active_name
            }
        }
    ' "$source_file" >"$java_methods_file" 2>/dev/null || : >"$java_methods_file"
}

render_java_change_details() {
    local index="$1"
    local path="$2"
    local start
    local end
    local attribution
    local method_start
    local method_end
    local method_name
    local shown_start
    local shown_end
    local found
    local key
    local existing
    local already_seen
    local seen_methods=()
    local detail_count=0

    collect_owned_runs "$index" "$path"
    extract_java_methods "$path"

    while IFS=$'\t' read -r start end attribution; do
        [[ -n "$start" ]] || continue
        if (( start == 0 )); then
            printf '      empty file '
            print_attribution "LOCAL"
            printf '\n'
            detail_count=$(( detail_count + 1 ))
            continue
        fi

        found=0
        while IFS=$'\t' read -r method_start method_end method_name; do
            [[ -n "$method_start" ]] || continue
            if (( start > method_end || end < method_start )); then
                continue
            fi
            shown_start=$start
            shown_end=$end
            (( shown_start < method_start )) && shown_start=$method_start
            (( shown_end > method_end )) && shown_end=$method_end
            printf '      '
            human_location "$path" "$shown_start"
            if (( shown_start == shown_end )); then
                printf '    '
            else
                printf ' [L%s-%s] ' "$shown_start" "$shown_end"
            fi
            style_stdout "$COLOR_GREEN" "$method_name()"
            printf ' '
            print_attribution "$attribution"
            printf '\n'
            found=1
            detail_count=$(( detail_count + 1 ))

            key="$method_start:$method_name"
            already_seen=0
            for existing in "${seen_methods[@]}"; do
                if [[ "$existing" == "$key" ]]; then
                    already_seen=1
                    break
                fi
            done
            if (( ! already_seen )); then
                seen_methods+=("$key")
                human_method_count=$(( human_method_count + 1 ))
            fi
        done <"$java_methods_file"

        if (( ! found )); then
            printf '      '
            human_location "$path" "$start"
            if (( start == end )); then
                printf '    '
            else
                printf ' [L%s-%s] ' "$start" "$end"
            fi
            style_stdout "$COLOR_MAGENTA" "<class-level>"
            printf ' '
            print_attribution "$attribution"
            printf '\n'
            detail_count=$(( detail_count + 1 ))
        fi
    done <"$owned_runs_file"

    if (( detail_count == 0 )); then
        if [[ "$resolved_status" == D* ]]; then
            printf '      '
            style_stdout "$COLOR_RED" "deleted source; use --patch for removed methods"
            printf '\n'
        elif [[ -z "$resolved_effective" ]]; then
            printf '      '
            style_stdout "$COLOR_DIM" "no longer differs from the review base"
            printf '\n'
        else
            printf '      '
            style_stdout "$COLOR_YELLOW" "no surviving lines attributed to the selected author"
            printf '\n'
        fi
    fi
}

render_current_lines() {
    local index
    local effective
    local status
    local path
    local i

    while IFS= read -r index; do
        [[ -n "$index" ]] || continue
        path="${candidate_paths[$index]}"
        effective=$(effective_index "$path") || continue
        status="${effective_statuses[$effective]}"

        if (( ${candidate_sources[$index]} & SOURCE_UNTRACKED )); then
            render_untracked_lines "$path"
            continue
        fi
        if [[ "$status" == D* ]]; then
            continue
        fi

        if (( include_local )); then
            [[ -f "$repo/$path" ]] || continue
        else
            git -C "$repo" cat-file -e "HEAD:$path" 2>/dev/null || continue
        fi

        if (( include_local )); then
            collect_ranges "$merge_base" "$path" "final"
            collect_ranges "HEAD" "$path" "local"
        else
            collect_ranges "$merge_base" "$path" "final" "HEAD"
            local_range_starts=()
            local_range_counts=()
        fi
        for (( i = 0; i < ${#range_starts[@]}; i++ )); do
            render_blame_range "$path" "${range_starts[$i]}" "${range_counts[$i]}"
        done
    done < <(sorted_candidate_indices)

    if (( line_output_count == 0 )); then
        style_stderr "$COLOR_YELLOW" "No surviving changed lines matched the selected author. Use --patch to inspect deletions and historical changes."
        printf '\n' >&2
    fi
}

main() {
    local configured_email
    local exclude_ref
    local exclude_tip

    parse_args "$@"
    configure_colors
    if (( porcelain )) && [[ "$mode" != "list" ]]; then
        die "--porcelain cannot be combined with --$mode" 2
    fi

    repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a Git worktree" 2
    invocation_dir=$(pwd -P) || die "cannot determine the current directory" 2
    [[ "$(git -C "$repo" rev-parse --is-bare-repository)" == "false" ]] || die "bare repositories are not supported" 2
    branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD) || die "detached HEAD is not supported; check out a branch or use Git directly" 2

    if (( ${#authors[@]} == 0 )); then
        configured_email=$(git -C "$repo" config --get user.email) || die "user.email is not configured for this repository" 2
        [[ -n "$configured_email" ]] || die "user.email is not configured for this repository" 2
        authors+=("$configured_email")
    fi

    if [[ -z "$base_ref" ]]; then
        base_ref=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD) || \
            die "origin/HEAD is unavailable; specify the review base with --base <ref>" 2
    fi
    [[ "$base_ref" != -* ]] || die "base ref cannot start with '-': $base_ref" 2
    git -C "$repo" rev-parse --verify --quiet "$base_ref^{commit}" >/dev/null || die "base ref does not resolve to a commit: $base_ref" 2
    merge_base=$(git -C "$repo" merge-base HEAD "$base_ref") || die "cannot find a merge base between HEAD and $base_ref" 2

    for exclude_ref in "${exclude_refs[@]}"; do
        [[ "$exclude_ref" != -* ]] || die "excluded branch ref cannot start with '-': $exclude_ref" 2
        exclude_tip=$(git -C "$repo" rev-parse --verify --quiet "$exclude_ref^{commit}") || \
            die "excluded branch ref does not resolve to a commit: $exclude_ref" 2
        exclude_tips+=("$exclude_tip")
    done

    ensure_temp_dir
    prepare_excluded_commits
    collect_committed_changes
    collect_local_changes
    collect_effective_changes

    case "$mode" in
        list)
            if (( porcelain )); then
                print_context
                render_list
            else
                detect_repository_type
                render_human
            fi
            ;;
        patch)
            print_context
            render_patch
            ;;
        current-lines)
            print_context
            render_current_lines
            ;;
    esac
}

main "$@"
