#!/bin/bash

readonly USAGE="Usage: ${0##*/} [update|stow]"

update_dotfiles() {
    cd "$HOME/.dotfiles" || return 1
    git pull --ff-only || return 1
    cd - >/dev/null
}

stow_dotfiles() {
    cd "$HOME/.dotfiles" || return 1
    stow --ignore=".DS_Store" -S */ || return 1
    cd - >/dev/null
}

if [[ $# -eq 0 ]]; then
    echo $USAGE && exit 1
fi

case "$1" in
    update)
        update_dotfiles
        ;;
    stow)
        stow_dotfiles
        ;;
    *)
        echo $USAGE && exit 1
        ;;
esac
