#!/bin/bash

readonly USAGE="Usage: ${0##*/} [update|stow|install <dev|server>]"

update_dotfiles() {
    cd "$HOME/.dotfiles" || return 1
    git pull --ff-only || return 1
    cd - >/dev/null
}

stow_dotfiles() {
    cd "$HOME/.dotfiles" || return 1
    stow --ignore=".DS_Store" -S */ || return 1
    cd - >/dev/null
}

install_dotfiles() {
    bash "$HOME/.dotfiles/setup/.setup/setup.sh" "$1"
}

if [[ $# -eq 0 ]]; then
    echo "$USAGE" && exit 1
fi

case "$1" in
    update)
        update_dotfiles
        ;;
    stow)
        stow_dotfiles
        ;;
    install)
        if [[ $# -ne 2 || ($2 != "dev" && $2 != "server") ]]; then
            echo "$USAGE"
            exit 1
        fi
        install_dotfiles "$2"
        ;;
    *)
        echo "$USAGE" && exit 1
        ;;
esac
