[core]
	editor = vim
	excludesFile = ~/.gitignore_global
	hooksPath = ~/.git-hooks
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	line-numbers = true
	navigate = true
[http "https://github.com"]
	proxy = http://127.0.0.1:7890
[includeIf "gitdir:~/.dotfiles/.git"]
	path = .gitconfig-github
[includeIf "gitdir:~/github/**"]
	path = .gitconfig-github
[includeIf "gitdir:~/company/xmly/**"]
	path = .gitconfig-xmly
[includeIf "gitdir:~/company/anxin/**"]
  path = .gitconfig-anxin
